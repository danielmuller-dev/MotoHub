generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  SUPER_ADMIN
  COMPANY_ADMIN
  EMPLOYEE
  CUSTOMER
}

enum UserStatus {
  ACTIVE
  INACTIVE
}

enum CompanyStatus {
  ACTIVE
  INACTIVE
  TRIAL
  BLOCKED
}

enum CompanyLicensePlan {
  FREE_30
  THIRTY_DAYS
  NINETY_DAYS
  ANNUAL
  LIFETIME
}

enum CustomerStatus {
  ACTIVE
  INACTIVE
}

enum MotorcycleStatus {
  AVAILABLE
  RENTED
  MAINTENANCE
  BLOCKED
  SOLD
  INACTIVE
}

enum ContractType {
  RENTAL
  RENT_TO_OWN
}

enum BillingFrequency {
  WEEKLY
  BIWEEKLY
  MONTHLY
}

enum WeekDay {
  SUNDAY
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
}

enum MonthlyOverflowRule {
  LAST_VALID_DAY
  NEXT_MONTH_FIRST_DAY
}

enum ContractStatus {
  DRAFT
  ACTIVE
  OVERDUE
  SUSPENDED
  COMPLETED
  CANCELLED
  TERMINATED
}

enum InstallmentStatus {
  PENDING
  PAID
  OVERDUE
  PARTIALLY_PAID
  CANCELLED
}

enum PaymentMethod {
  PIX
  CASH
  TRANSFER
  CARD
  BOLETO
  OTHER
}

enum PaymentStatus {
  CONFIRMED
  REVERSED
}

enum ContractEventType {
  CONTRACT_CREATED
  CONTRACT_ACTIVATED
  CONTRACT_EDITED
  INSTALLMENT_GENERATED
  PAYMENT_REGISTERED
  PAYMENT_PARTIAL
  PAYMENT_REVERSED
  INSTALLMENT_OVERDUE
  INSTALLMENT_RENEGOTIATED
  DISCOUNT_APPLIED
  FINE_APPLIED
  CONTRACT_SUSPENDED
  CONTRACT_RESUMED
  CONTRACT_TERMINATED
  CONTRACT_CANCELLED
  CONTRACT_COMPLETED
  MOTORCYCLE_STATUS_CHANGED
  INSPECTION_CREATED
  INSPECTION_COMPLETED
  INSPECTION_CANCELLED
  INSPECTION_DAMAGE_REGISTERED
  INSPECTION_CHARGE_CREATED
  INSPECTION_MAINTENANCE_CREATED
}

enum InspectionType {
  DELIVERY
  PERIODIC
  RETURN
  EXTRAORDINARY
}

enum InspectionStatus {
  DRAFT
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum InspectionItemCondition {
  OK
  DAMAGED
  MISSING
  NEEDS_MAINTENANCE
  NOT_APPLICABLE
  NOT_CHECKED
}

enum FuelLevel {
  EMPTY
  RESERVE
  ONE_QUARTER
  HALF
  THREE_QUARTERS
  FULL
}

enum InspectionPhotoType {
  FRONT
  REAR
  LEFT_SIDE
  RIGHT_SIDE
  ODOMETER
  PLATE
  ENGINE
  FRONT_TIRE
  REAR_TIRE
  DAMAGE
  ACCESSORY
  SIGNATURE
  OTHER
}

enum DamageSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum DamageStatus {
  OPEN
  UNDER_REVIEW
  APPROVED
  REJECTED
  CHARGED
  REPAIRED
  CANCELLED
}

enum DamageResponsibleParty {
  CUSTOMER
  COMPANY
  THIRD_PARTY
  UNDEFINED
}

enum InspectionSignatureType {
  EMPLOYEE
  CUSTOMER
}

enum AdditionalChargeType {
  DAMAGE
  MILEAGE_EXCESS
  MISSING_ACCESSORY
  FUEL_DIFFERENCE
  FINE
  OTHER
}

enum AdditionalChargeStatus {
  PENDING
  PARTIALLY_PAID
  PAID
  CANCELLED
  OVERDUE
}

enum MaintenanceType {
  PREVENTIVE
  CORRECTIVE
  OIL_CHANGE
  TIRES
  BRAKES
  CHAIN
  ELECTRICAL
  INSPECTION
  OTHER
}

enum MaintenanceStatus {
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum DocumentType {
  CNH
  CRLV
  SIGNED_CONTRACT
  PROOF_OF_ADDRESS
  PERSONAL_DOCUMENT
  INSURANCE
  INSPECTION
  OTHER
}

enum DocumentStatus {
  VALID
  EXPIRING_SOON
  EXPIRED
  ARCHIVED
}

enum NotificationType {
  PAYMENT
  MAINTENANCE
  DOCUMENT
  CONTRACT
  GENERAL
}

enum NotificationPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum NotificationStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

model Company {
  id                 String             @id @default(cuid())
  legalName          String
  tradeName          String?
  document           String?
  email              String?
  phone              String?
  whatsapp           String?
  address            String?
  city               String?
  state              String?
  zipCode            String?
  logoUrl            String?
  slug               String             @unique
  status             CompanyStatus      @default(ACTIVE)
  subscriptionStatus String?            @default("trial")
  trialEndsAt        DateTime?
  licensePlan        CompanyLicensePlan @default(FREE_30)
  licenseStartsAt    DateTime           @default(now())
  licenseExpiresAt   DateTime?
  licenseUpdatedAt   DateTime?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  deletedAt          DateTime?

  settings              CompanySettings?
  users                 User[]
  customers             Customer[]
  motorcycles           Motorcycle[]
  contracts             Contract[]
  installments          Installment[]
  payments              Payment[]
  maintenances          Maintenance[]
  documents             Document[]
  notifications         Notification[]
  auditLogs             AuditLog[]
  contractEvents        ContractEvent[]
  inspections           Inspection[]
  inspectionItems       InspectionItem[]
  inspectionPhotos      InspectionPhoto[]
  inspectionDamages     InspectionDamage[]
  inspectionAccessories InspectionAccessory[]
  inspectionSignatures  InspectionSignature[]
  additionalCharges     AdditionalCharge[]

  @@index([status])
  @@index([licensePlan])
  @@index([licenseExpiresAt])
  @@index([createdAt])
}

model CompanySettings {
  id                     String   @id @default(cuid())
  companyId              String   @unique
  currency               String   @default("BRL")
  timezone               String   @default("America/Bahia")
  receiptDefaultText     String?
  defaultLateFee         Decimal  @default(0) @db.Decimal(10, 2)
  defaultInterest        Decimal  @default(0) @db.Decimal(10, 2)
  defaultGracePeriodDays Int      @default(0)
  displayPreferences     Json?
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Restrict)
}

model User {
  id           String     @id @default(cuid())
  companyId    String?
  customerId   String?    @unique
  name         String
  email        String     @unique
  passwordHash String
  role         UserRole
  status       UserStatus @default(ACTIVE)
  phone        String?
  lastLoginAt  DateTime?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  deletedAt    DateTime?

  company                  Company?           @relation(fields: [companyId], references: [id], onDelete: Restrict)
  customer                 Customer?          @relation("CustomerUser", fields: [customerId], references: [id], onDelete: SetNull)
  paymentsRegistered       Payment[]          @relation("PaymentRegisteredBy")
  paymentsReversed         Payment[]          @relation("PaymentReversedBy")
  contractEvents           ContractEvent[]
  inspectionsCreated       Inspection[]       @relation("InspectionCreatedBy")
  inspectionsCompleted     Inspection[]       @relation("InspectionCompletedBy")
  inspectionsCancelled     Inspection[]       @relation("InspectionCancelledBy")
  inspectionPhotosUploaded InspectionPhoto[]  @relation("InspectionPhotoUploadedBy")
  additionalChargesCreated AdditionalCharge[] @relation("AdditionalChargeCreatedBy")
  notificationsCreated     Notification[]     @relation("NotificationCreatedBy")
  auditLogs                AuditLog[]

  @@index([companyId, role])
  @@index([status])
}

model Customer {
  id                      String         @id @default(cuid())
  companyId               String
  fullName                String
  cpf                     String
  birthDate               DateTime?
  email                   String?
  phone                   String?
  whatsapp                String?
  address                 String?
  number                  String?
  complement              String?
  district                String?
  city                    String?
  state                   String?
  zipCode                 String?
  driverLicenseNumber     String?
  driverLicenseCategory   String?
  driverLicenseExpiration DateTime?
  identityNumber          String?
  emergencyContactName    String?
  emergencyContactPhone   String?
  notes                   String?
  status                  CustomerStatus @default(ACTIVE)
  createdAt               DateTime       @default(now())
  updatedAt               DateTime       @updatedAt
  deletedAt               DateTime?

  company                Company                 @relation(fields: [companyId], references: [id], onDelete: Restrict)
  user                   User?                   @relation("CustomerUser")
  currentMotorcycles     Motorcycle[]            @relation("CurrentMotorcycleCustomer")
  contracts              Contract[]
  payments               Payment[]
  documents              Document[]
  notificationRecipients NotificationRecipient[]
  inspections            Inspection[]
  additionalCharges      AdditionalCharge[]

  @@unique([companyId, cpf])
  @@unique([companyId, email])
  @@index([companyId, fullName])
  @@index([companyId, status])
}

model Motorcycle {
  id                String           @id @default(cuid())
  companyId         String
  currentCustomerId String?
  brand             String
  model             String
  manufactureYear   Int?
  modelYear         Int?
  plate             String
  renavam           String?
  chassis           String?
  color             String?
  engineCapacity    Int?
  currentMileage    Int              @default(0)
  acquisitionValue  Decimal?         @db.Decimal(12, 2)
  acquisitionDate   DateTime?
  photoUrl          String?
  notes             String?
  status            MotorcycleStatus @default(AVAILABLE)
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  deletedAt         DateTime?

  company           Company            @relation(fields: [companyId], references: [id], onDelete: Restrict)
  currentCustomer   Customer?          @relation("CurrentMotorcycleCustomer", fields: [currentCustomerId], references: [id], onDelete: SetNull)
  contracts         Contract[]
  maintenances      Maintenance[]
  documents         Document[]
  inspections       Inspection[]
  additionalCharges AdditionalCharge[]

  @@unique([companyId, plate])
  @@unique([companyId, renavam])
  @@unique([companyId, chassis])
  @@index([companyId, status])
  @@index([companyId, brand, model])
}

model Contract {
  id                         String              @id @default(cuid())
  companyId                  String
  customerId                 String
  motorcycleId               String
  code                       String
  type                       ContractType
  startDate                  DateTime
  expectedEndDate            DateTime?
  billingFrequency           BillingFrequency
  firstDueDate               DateTime
  weeklyDueDay               WeekDay?
  monthlyDueDay              Int?
  monthlyOverflowRule        MonthlyOverflowRule @default(LAST_VALID_DAY)
  installmentAmount          Decimal             @db.Decimal(12, 2)
  totalInstallments          Int
  downPayment                Decimal             @default(0) @db.Decimal(12, 2)
  totalAmount                Decimal             @db.Decimal(12, 2)
  lateInterestAmount         Decimal             @default(0) @db.Decimal(12, 2)
  lateFeeAmount              Decimal             @default(0) @db.Decimal(12, 2)
  gracePeriodDays            Int                 @default(0)
  initialMileage             Int?
  mileageLimit               Int?
  depositAmount              Decimal?            @db.Decimal(12, 2)
  notes                      String?
  customTerms                String?
  status                     ContractStatus      @default(DRAFT)
  activatedAt                DateTime?
  completedAt                DateTime?
  cancelledAt                DateTime?
  cancellationReason         String?
  cancellationNotes          String?
  terminatedAt               DateTime?
  terminationReason          String?
  terminationNotes           String?
  suspendedAt                DateTime?
  suspensionReason           String?
  suspensionNotes            String?
  suspensionExpectedResumeAt DateTime?
  resumedAt                  DateTime?
  resumeNotes                String?
  closedByUserId             String?
  createdAt                  DateTime            @default(now())
  updatedAt                  DateTime            @updatedAt
  deletedAt                  DateTime?

  company           Company            @relation(fields: [companyId], references: [id], onDelete: Restrict)
  customer          Customer           @relation(fields: [customerId], references: [id], onDelete: Restrict)
  motorcycle        Motorcycle         @relation(fields: [motorcycleId], references: [id], onDelete: Restrict)
  installments      Installment[]
  payments          Payment[]
  documents         Document[]
  events            ContractEvent[]
  inspections       Inspection[]
  additionalCharges AdditionalCharge[]

  @@unique([companyId, code])
  @@index([companyId, status])
  @@index([companyId, customerId])
  @@index([companyId, motorcycleId])
}

model Installment {
  id                   String            @id @default(cuid())
  companyId            String
  contractId           String
  number               Int
  dueDate              DateTime
  originalDueDate      DateTime?
  originalAmount       Decimal           @db.Decimal(12, 2)
  penaltyAmount        Decimal           @default(0) @db.Decimal(12, 2)
  interestAmount       Decimal           @default(0) @db.Decimal(12, 2)
  discountAmount       Decimal           @default(0) @db.Decimal(12, 2)
  finalAmount          Decimal           @db.Decimal(12, 2)
  paidAmount           Decimal           @default(0) @db.Decimal(12, 2)
  paymentDate          DateTime?
  status               InstallmentStatus @default(PENDING)
  note                 String?
  renegotiatedAt       DateTime?
  renegotiatedByUserId String?
  renegotiationReason  String?
  renegotiationNotes   String?
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt

  company  Company   @relation(fields: [companyId], references: [id], onDelete: Restrict)
  contract Contract  @relation(fields: [contractId], references: [id], onDelete: Restrict)
  payments Payment[]

  @@unique([contractId, number])
  @@index([companyId, status, dueDate])
  @@index([companyId, dueDate])
}

model Payment {
  id                 String        @id @default(cuid())
  companyId          String
  customerId         String
  contractId         String
  installmentId      String?
  additionalChargeId String?
  registeredByUserId String?
  code               String
  amountPaid         Decimal       @db.Decimal(12, 2)
  paymentDate        DateTime
  method             PaymentMethod
  status             PaymentStatus @default(CONFIRMED)
  reference          String?
  note               String?
  receiptUrl         String?
  reversedAt         DateTime?
  reversedByUserId   String?
  reversalReason     String?
  reversalNotes      String?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  company          Company           @relation(fields: [companyId], references: [id], onDelete: Restrict)
  customer         Customer          @relation(fields: [customerId], references: [id], onDelete: Restrict)
  contract         Contract          @relation(fields: [contractId], references: [id], onDelete: Restrict)
  installment      Installment?      @relation(fields: [installmentId], references: [id], onDelete: Restrict)
  additionalCharge AdditionalCharge? @relation(fields: [additionalChargeId], references: [id], onDelete: Restrict)
  registeredBy     User?             @relation("PaymentRegisteredBy", fields: [registeredByUserId], references: [id], onDelete: SetNull)
  reversedBy       User?             @relation("PaymentReversedBy", fields: [reversedByUserId], references: [id], onDelete: SetNull)

  @@unique([companyId, code])
  @@index([companyId, paymentDate])
  @@index([companyId, method])
  @@index([companyId, status])
  @@index([companyId, additionalChargeId])
}

model Maintenance {
  id                     String            @id @default(cuid())
  companyId              String
  motorcycleId           String
  inspectionId           String?
  type                   MaintenanceType
  description            String
  date                   DateTime
  mileage                Int?
  amount                 Decimal           @default(0) @db.Decimal(12, 2)
  workshop               String?
  nextMaintenanceDate    DateTime?
  nextMaintenanceMileage Int?
  status                 MaintenanceStatus @default(SCHEDULED)
  notes                  String?
  createdAt              DateTime          @default(now())
  updatedAt              DateTime          @updatedAt

  company    Company     @relation(fields: [companyId], references: [id], onDelete: Restrict)
  motorcycle Motorcycle  @relation(fields: [motorcycleId], references: [id], onDelete: Restrict)
  inspection Inspection? @relation(fields: [inspectionId], references: [id], onDelete: SetNull)

  @@index([companyId, status, date])
  @@index([companyId, motorcycleId])
  @@index([companyId, inspectionId])
}

model Document {
  id                String         @id @default(cuid())
  companyId         String
  customerId        String?
  motorcycleId      String?
  contractId        String?
  name              String
  type              DocumentType
  number            String?
  issueDate         DateTime?
  expirationDate    DateTime?
  fileUrl           String
  note              String?
  visibleToCustomer Boolean        @default(false)
  status            DocumentStatus @default(VALID)
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  company    Company     @relation(fields: [companyId], references: [id], onDelete: Restrict)
  customer   Customer?   @relation(fields: [customerId], references: [id], onDelete: SetNull)
  motorcycle Motorcycle? @relation(fields: [motorcycleId], references: [id], onDelete: SetNull)
  contract   Contract?   @relation(fields: [contractId], references: [id], onDelete: SetNull)

  @@index([companyId, status, expirationDate])
  @@index([companyId, customerId])
  @@index([companyId, motorcycleId])
}

model Notification {
  id              String               @id @default(cuid())
  companyId       String
  createdByUserId String?
  title           String
  message         String
  type            NotificationType
  priority        NotificationPriority @default(NORMAL)
  publishedAt     DateTime             @default(now())
  expiresAt       DateTime?
  status          NotificationStatus   @default(PUBLISHED)
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  company    Company                 @relation(fields: [companyId], references: [id], onDelete: Restrict)
  createdBy  User?                   @relation("NotificationCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  recipients NotificationRecipient[]

  @@index([companyId, status, publishedAt])
  @@index([companyId, priority])
}

model NotificationRecipient {
  id             String    @id @default(cuid())
  notificationId String
  customerId     String
  readAt         DateTime?
  createdAt      DateTime  @default(now())

  notification Notification @relation(fields: [notificationId], references: [id], onDelete: Restrict)
  customer     Customer     @relation(fields: [customerId], references: [id], onDelete: Restrict)

  @@unique([notificationId, customerId])
  @@index([customerId, readAt])
}

model AuditLog {
  id          String   @id @default(cuid())
  companyId   String?
  userId      String?
  action      String
  entity      String
  entityId    String
  description String
  before      Json?
  after       Json?
  createdAt   DateTime @default(now())

  company Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)
  user    User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([companyId, createdAt])
  @@index([entity, entityId])
}

model ContractEvent {
  id          String            @id @default(cuid())
  companyId   String
  contractId  String
  userId      String?
  type        ContractEventType
  title       String
  description String
  metadata    Json?
  createdAt   DateTime          @default(now())

  company  Company  @relation(fields: [companyId], references: [id], onDelete: Restrict)
  contract Contract @relation(fields: [contractId], references: [id], onDelete: Restrict)
  user     User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([companyId, contractId, createdAt])
  @@index([companyId, type])
}

model Inspection {
  id                       String            @id @default(cuid())
  companyId                String
  contractId               String?
  motorcycleId             String
  customerId               String?
  createdByUserId          String?
  completedByUserId        String?
  cancelledByUserId        String?
  code                     String
  type                     InspectionType
  status                   InspectionStatus  @default(DRAFT)
  inspectionDate           DateTime
  mileage                  Int
  fuelLevel                FuelLevel
  generalCondition         String?
  generalDamages           String?
  location                 String?
  notes                    String?
  administrativeNotes      String?
  customerPresent          Boolean           @default(false)
  customerRefusedSignature Boolean           @default(false)
  refusalReason            String?
  completedAt              DateTime?
  cancelledAt              DateTime?
  cancellationReason       String?
  deliveryConfirmedAt      DateTime?
  returnedAt               DateTime?
  destinationStatus        MotorcycleStatus?
  mileageDriven            Int?
  mileageExcess            Int?
  mileageExcessCharge      Decimal           @default(0) @db.Decimal(12, 2)
  createdAt                DateTime          @default(now())
  updatedAt                DateTime          @updatedAt

  company      Company               @relation(fields: [companyId], references: [id], onDelete: Restrict)
  contract     Contract?             @relation(fields: [contractId], references: [id], onDelete: Restrict)
  motorcycle   Motorcycle            @relation(fields: [motorcycleId], references: [id], onDelete: Restrict)
  customer     Customer?             @relation(fields: [customerId], references: [id], onDelete: SetNull)
  createdBy    User?                 @relation("InspectionCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  completedBy  User?                 @relation("InspectionCompletedBy", fields: [completedByUserId], references: [id], onDelete: SetNull)
  cancelledBy  User?                 @relation("InspectionCancelledBy", fields: [cancelledByUserId], references: [id], onDelete: SetNull)
  items        InspectionItem[]
  photos       InspectionPhoto[]
  damages      InspectionDamage[]
  accessories  InspectionAccessory[]
  signatures   InspectionSignature[]
  charges      AdditionalCharge[]
  maintenances Maintenance[]

  @@unique([companyId, code])
  @@index([companyId, type, status])
  @@index([companyId, inspectionDate])
  @@index([companyId, contractId])
  @@index([companyId, motorcycleId])
  @@index([companyId, customerId])
}

model InspectionItem {
  id              String                  @id @default(cuid())
  companyId       String
  inspectionId    String
  category        String
  itemKey         String
  itemLabel       String
  condition       InspectionItemCondition @default(NOT_CHECKED)
  notes           String?
  photoUrl        String?
  estimatedCost   Decimal                 @default(0) @db.Decimal(12, 2)
  preExisting     Boolean                 @default(false)
  newDamage       Boolean                 @default(false)
  chargeCustomer  Boolean                 @default(false)
  evaluatorUserId String?
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt

  company    Company            @relation(fields: [companyId], references: [id], onDelete: Restrict)
  inspection Inspection         @relation(fields: [inspectionId], references: [id], onDelete: Restrict)
  photos     InspectionPhoto[]
  damages    InspectionDamage[]

  @@index([companyId, inspectionId])
  @@index([companyId, itemKey])
}

model InspectionPhoto {
  id               String              @id @default(cuid())
  companyId        String
  inspectionId     String
  inspectionItemId String?
  type             InspectionPhotoType
  url              String
  storageKey       String
  contentType      String?
  sizeBytes        Int?
  caption          String?
  sortOrder        Int                 @default(0)
  uploadedByUserId String?
  createdAt        DateTime            @default(now())
  deletedAt        DateTime?

  company    Company         @relation(fields: [companyId], references: [id], onDelete: Restrict)
  inspection Inspection      @relation(fields: [inspectionId], references: [id], onDelete: Restrict)
  item       InspectionItem? @relation(fields: [inspectionItemId], references: [id], onDelete: SetNull)
  uploadedBy User?           @relation("InspectionPhotoUploadedBy", fields: [uploadedByUserId], references: [id], onDelete: SetNull)

  @@index([companyId, inspectionId, type])
  @@index([companyId, inspectionItemId])
}

model InspectionDamage {
  id                   String                 @id @default(cuid())
  companyId            String
  inspectionId         String
  inspectionItemId     String?
  title                String
  description          String?
  severity             DamageSeverity         @default(LOW)
  preExisting          Boolean                @default(false)
  newDamage            Boolean                @default(false)
  chargeCustomer       Boolean                @default(false)
  estimatedCost        Decimal                @default(0) @db.Decimal(12, 2)
  approvedChargeAmount Decimal                @default(0) @db.Decimal(12, 2)
  status               DamageStatus           @default(OPEN)
  responsibleParty     DamageResponsibleParty @default(UNDEFINED)
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt

  company    Company            @relation(fields: [companyId], references: [id], onDelete: Restrict)
  inspection Inspection         @relation(fields: [inspectionId], references: [id], onDelete: Restrict)
  item       InspectionItem?    @relation(fields: [inspectionItemId], references: [id], onDelete: SetNull)
  charges    AdditionalCharge[]

  @@index([companyId, inspectionId])
  @@index([companyId, status])
}

model InspectionAccessory {
  id              String                  @id @default(cuid())
  companyId       String
  inspectionId    String
  name            String
  delivered       Boolean                 @default(false)
  returned        Boolean                 @default(false)
  condition       InspectionItemCondition @default(NOT_CHECKED)
  notes           String?
  replacementCost Decimal                 @default(0) @db.Decimal(12, 2)
  chargeCustomer  Boolean                 @default(false)
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt

  company    Company    @relation(fields: [companyId], references: [id], onDelete: Restrict)
  inspection Inspection @relation(fields: [inspectionId], references: [id], onDelete: Restrict)

  @@index([companyId, inspectionId])
}

model InspectionSignature {
  id           String                  @id @default(cuid())
  companyId    String
  inspectionId String
  type         InspectionSignatureType
  imageUrl     String
  storageKey   String
  signedByName String
  signedAt     DateTime
  createdAt    DateTime                @default(now())

  company    Company    @relation(fields: [companyId], references: [id], onDelete: Restrict)
  inspection Inspection @relation(fields: [inspectionId], references: [id], onDelete: Restrict)

  @@index([companyId, inspectionId, type])
}

model AdditionalCharge {
  id                 String                 @id @default(cuid())
  companyId          String
  contractId         String
  customerId         String
  motorcycleId       String
  inspectionId       String?
  inspectionDamageId String?
  createdByUserId    String?
  code               String
  type               AdditionalChargeType
  description        String
  amount             Decimal                @db.Decimal(12, 2)
  dueDate            DateTime
  status             AdditionalChargeStatus @default(PENDING)
  paidAmount         Decimal                @default(0) @db.Decimal(12, 2)
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt

  company    Company           @relation(fields: [companyId], references: [id], onDelete: Restrict)
  contract   Contract          @relation(fields: [contractId], references: [id], onDelete: Restrict)
  customer   Customer          @relation(fields: [customerId], references: [id], onDelete: Restrict)
  motorcycle Motorcycle        @relation(fields: [motorcycleId], references: [id], onDelete: Restrict)
  inspection Inspection?       @relation(fields: [inspectionId], references: [id], onDelete: SetNull)
  damage     InspectionDamage? @relation(fields: [inspectionDamageId], references: [id], onDelete: SetNull)
  createdBy  User?             @relation("AdditionalChargeCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  payments   Payment[]

  @@unique([companyId, code])
  @@index([companyId, status, dueDate])
  @@index([companyId, contractId])
  @@index([companyId, inspectionId])
}
